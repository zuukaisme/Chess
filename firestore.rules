rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidChessRoom(data) {
      return data.roomId is string &&
             data.roomId.size() == 6 &&
             data.hostPlayerId is string &&
             data.status in ['WAITING', 'PLAYING', 'FINISHED'] &&
             data.currentFen is string;
    }

    function isValidUserProfile(data) {
      return data.userId is string &&
             data.displayName is string;
    }

    match /chess_rooms/{roomId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                       request.resource.data.hostPlayerId == request.auth.uid &&
                       isValidChessRoom(request.resource.data);
      allow update: if isAuthenticated() &&
                       (resource.data.hostPlayerId == request.auth.uid ||
                        resource.data.guestPlayerId == request.auth.uid ||
                        resource.data.guestPlayerId == "") &&
                       isValidChessRoom(request.resource.data);
      allow delete: if isAuthenticated() &&
                       resource.data.hostPlayerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow delete: if isOwner(userId);
    }
  }
}
